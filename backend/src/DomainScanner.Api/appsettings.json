{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgresConnection": "",
    "RedisConnection": ""
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Issuer": "DomainScanner.Auth",
    "Audience": "DomainScanner.Api",
    "ExpiresHours": "24"
  },
  "ReverseProxy": {
    "Enabled": false,
    "TrustedProxy": "",
    "ForwardLimit": 1
  },
  "LoginAccountKeyOptions": {
    "HmacSecret": ""
  },
  "LoginProtectionOptions": {
    "KeyPrefix": "domain-scanner",
    "FailureWindowMinutes": 15,
    "LockoutThreshold": 5,
    "LockoutDurationMinutes": 10,
    "MaximumLockoutMinutes": 60,
    "EscalationWindowMinutes": 1440,
    "DelayStartAttempt": 3,
    "InitialDelayMilliseconds": 500,
    "MaximumDelayMilliseconds": 2000
  },
  "RateLimiting": {
    "Read": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Write": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Scan": {
      "PermitLimit": 15,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "ScanConcurrency": {
      "PermitLimit": 5,
      "QueueLimit": 0
    }
  },
  "RedisCacheOptions": {
    "InstanceName": "",
    "DefaultExpirationMinutes": ""
  }
}
