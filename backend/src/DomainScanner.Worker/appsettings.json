{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PostgresConnection": "",
    "RedisConnection": ""
  },
  "DomainChecksWorker": {
    "RecurringJobId": "domain-checks-recurring",
    "CronExpression": "*/5 * * * *",
    "QueueName": "domain-checks",
    "BatchSize": 30,
    "MaxDomainsPerRun": 500,
    "RetentionDays": 30,
    "MaxResultsPerDomain": 100
  }
}