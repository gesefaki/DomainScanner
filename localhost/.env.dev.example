# PostgreSQL
POSTGRES_DB=scannerdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_INSTANCE_NAME=domain-scanner-dev
REDIS_DEFAULT_EXPIRATION_MINUTES=2

# ASP.NET API
API_PORT=8080
API_HTTPS_PORT=8443

# Hangfire Worker
RECURRING_JOB_ID=domain-checks-recurring
WORKER_CRON_EXPRESSION=*/5 * * * *
WORKER_QUEUE_NAME=domains-checks
WORKER_BATCH_SIZE=30

# JWT 
JWT_SECRETKEY=replace-with-a-development-secret-at-least-32-bytes-long

# HTTPS
HTTPS_CERT_PATH=./certs/domainscanner-dev.pfx
HTTPS_CERT_PASSWORD=local-dev-password

# HMAC
LOGIN_ACCOUNT_KEY_SECRET=replace-with-a-not-jwt-equal-secret-at-least-32-bytes-long